---
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-xl font-bold sm:my-8 sm:text-3xl">
        小泉幸太のページ
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <div class="relative">
        <p>
      フランス文学を研究する大学院生です。第一には研究ブログというのが名目ですが、ただの日記のようなものもあります。日々の学びのアウトプットや論理的な文章を書く習慣をつけることが、ある意味で中心的な目的です。また、学問的な内容を一般の人にも広く知ってもらいたいという目的もあります。
      <br>
      本ページの文章はいかなる箇所に置いてもAIの生成物を利用しません。ある意味で自分の生きがいを他人に委託するような行為になるからです。調べ物や事実調査に用いることはありますが、文章の生成物はどこにもありません。
      </p>
    <div class="text-right">
      <a 
        href="/about/" 
        class="text-sm text-gray-500 hover:text-accent transition-colors duration-200"
      >
        詳しく <span class="inline-block translate-y-[1px] hover:translate-y-[5px]">→</span>
      </a>
    </div>
  </div>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">SNS:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">ピンどめ記事</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">さいきんの記事</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <!-- ナビゲーションカード -->
    <div class="my-10 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <a href="/posts/" class="nav-card group">
        <div class="nav-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
        </div>
        <div class="nav-card-body">
          <span class="nav-card-title">記事一覧</span>
          <span class="nav-card-desc">すべての投稿</span>
        </div>
        <svg class="nav-card-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </a>

      <a href="/archives/" class="nav-card group">
        <div class="nav-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <div class="nav-card-body">
          <span class="nav-card-title">アーカイブ</span>
          <span class="nav-card-desc">年月別の記録</span>
        </div>
        <svg class="nav-card-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </a>

      <a href="/wiki/" class="nav-card group">
        <div class="nav-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
        </div>
        <div class="nav-card-body">
          <span class="nav-card-title">事典</span>
          <span class="nav-card-desc">概念・用語のまとめ</span>
        </div>
        <svg class="nav-card-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .nav-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
    text-decoration: none;
    color: inherit;
  }
  .nav-card:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    transform: translateY(-1px);
  }
  .nav-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--muted);
    color: var(--accent);
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .nav-card:hover .nav-card-icon {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
  }
  .nav-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .nav-card-title {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .nav-card-desc {
    font-size: 0.75rem;
    opacity: 0.5;
  }
  .nav-card-arrow {
    opacity: 0.3;
    transition: opacity 0.15s, transform 0.15s;
    flex-shrink: 0;
  }
  .nav-card:hover .nav-card-arrow {
    opacity: 0.8;
    transform: translateX(2px);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
