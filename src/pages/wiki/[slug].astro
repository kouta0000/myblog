---
export const prerender = true;
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export async function getStaticPaths() {
  const entries = await getCollection("wiki", ({ data }) => !data.draft);
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const tabs = headings.filter(h => h.depth === 1);
---

<Layout title={`${entry.data.title} — 事典`} description={entry.data.description}>
  <Header />
  <main id="main-content" class="app-layout">

    <!-- パンくず -->
    <nav class="pt-5 pb-3 text-xs" style="opacity: 0.5;" aria-label="breadcrumb">
      <a href="/wiki/" class="hover:text-accent transition-colors" style="opacity: 1;">事典</a>
      <span class="mx-2">/</span>
      <span>{entry.data.title}</span>
    </nav>

    <!-- タイトルエリア -->
    <div class="border-b border-border pb-5">
      <h1 class="text-2xl font-bold sm:text-3xl">{entry.data.title}</h1>
      <p class="mt-2 text-sm leading-relaxed" style="opacity: 0.6;">{entry.data.description}</p>
      {entry.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {entry.data.tags.map(tag => (
            <span class="rounded-sm px-2 py-0.5 text-[11px] font-medium"
              style="background: var(--muted); opacity: 0.8;">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- タブバー（H1見出し対応） -->
    {tabs.length > 1 && (
      <div
        id="wiki-tabs"
        class="sticky top-0 z-10 -mx-4 border-b"
        style="background: color-mix(in srgb, var(--background) 95%, transparent); backdrop-filter: blur(8px); border-color: var(--border);"
        role="tablist"
        aria-label="セクション"
      >
        <div class="flex overflow-x-auto px-4 scrollbar-none">
          {tabs.map((tab, i) => (
            <button
              role="tab"
              data-slug={tab.slug}
              aria-selected={i === 0 ? "true" : "false"}
              class="wiki-tab relative shrink-0 px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors duration-150 focus:outline-none"
              style={i === 0 ? "color: var(--accent);" : "opacity: 0.5;"}
            >
              {tab.text}
              <span class="tab-indicator absolute bottom-0 left-0 right-0 h-0.5 rounded-t transition-transform duration-200"
                style={`background: var(--accent); transform: scaleX(${i === 0 ? 1 : 0}); transform-origin: left;`}
                aria-hidden="true"
              ></span>
            </button>
          ))}
        </div>
      </div>
    )}

    <!-- 記事本文 -->
    <article id="wiki-content" class="wiki-article py-8">
      <Content />
    </article>

    <!-- フッターメタ -->
    {entry.data.modDatetime && (
      <p class="mb-10 border-t border-border pt-4 text-xs" style="opacity: 0.4;">
        最終更新: {new Date(entry.data.modDatetime).toLocaleDateString("ja-JP", {
          year: "numeric", month: "long", day: "numeric"
        })}
      </p>
    )}
  </main>
  <Footer />
</Layout>

<style>
  /* 本文タイポグラフィ */
  .wiki-article :global(h1) {
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 4rem;
  }
  .wiki-article :global(h1:first-child) { margin-top: 0; }
  .wiki-article :global(h2) {
    font-size: 1rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 4rem;
  }
  .wiki-article :global(h3) {
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    opacity: 0.85;
    scroll-margin-top: 4rem;
  }
  .wiki-article :global(p) {
    font-size: 0.9rem;
    line-height: 1.8;
    margin-bottom: 1rem;
    opacity: 0.9;
  }
  .wiki-article :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .wiki-article :global(strong) { font-weight: 600; }
  .wiki-article :global(ul), .wiki-article :global(ol) {
    margin: 0.75rem 0 1rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.75;
  }
  .wiki-article :global(li) { margin-bottom: 0.25rem; }
  .wiki-article :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1rem 0;
    opacity: 0.75;
    font-style: italic;
  }

  /* タブアクティブ状態 */
  .wiki-tab[aria-selected="true"] { color: var(--accent); opacity: 1; }
  .wiki-tab[aria-selected="false"] { opacity: 0.5; }
  .wiki-tab[aria-selected="true"] .tab-indicator { transform: scaleX(1); }
  .wiki-tab[aria-selected="false"] .tab-indicator { transform: scaleX(0); }

  /* スクロールバー非表示 */
  .scrollbar-none { scrollbar-width: none; }
  .scrollbar-none::-webkit-scrollbar { display: none; }
</style>

<script>
  function initWikiArticle() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".wiki-tab");
    if (!tabs.length) return;

    const article = document.getElementById("wiki-content");
    const h1s = article?.querySelectorAll<HTMLElement>("h1");
    if (!h1s?.length) return;

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const slug = tab.dataset.slug;
        const target = article?.querySelector<HTMLElement>(`#${slug}`);
        if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tabs.forEach(tab => {
              const active = tab.dataset.slug === id;
              tab.setAttribute("aria-selected", active ? "true" : "false");
            });
          }
        });
      },
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
    );

    h1s.forEach(h1 => observer.observe(h1));
  }

  initWikiArticle();
  document.addEventListener("astro:after-swap", initWikiArticle);
</script>
